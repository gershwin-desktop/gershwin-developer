+#ifdef HAVE_XRANDR
+/* Scale factor of one monitor, 0 when nothing is known about it.
+ * The RandR output property "DPI" (96 = 1.0x) is what XLibre creates on
+ * every output (X11Libre/xserver#208); servers without it accept a client
+ * creating it, so the display configuration can set a per-monitor scale
+ * on any server and every client hears about the change.  The physical
+ * size is only used when the user asks for it, because servers often
+ * report wrong millimetres; the targets follow mutter (110 dpi for large
+ * monitors, 135 dpi for laptop panels).
+ */
+static CGFloat
+_scaleFactorForOutput(Display *dpy, RROutput output,
+                      XRROutputInfo *output_info, XRRCrtcInfo *crtc_info)
+{
+  Atom		dpi_atom;
+  Atom		type;
+  int		format;
+  unsigned long	nitems;
+  unsigned long	bytes_after;
+  unsigned char	*data = NULL;
+  CGFloat	factor = 0.0;
+
+  dpi_atom = XInternAtom(dpy, "DPI", True);
+  if (dpi_atom != None
+    && XRRGetOutputProperty(dpy, output, dpi_atom, 0, 1, False, False,
+      AnyPropertyType, &type, &format, &nitems, &bytes_after,
+      &data) == Success)
+    {
+      if (data != NULL && type == XA_INTEGER && format == 32 && nitems == 1)
+	{
+	  long	dpi = *(long *)data;
+
+	  if (dpi > 0)
+	    {
+	      factor = dpi / 96.0;
+	    }
+	}
+      if (data != NULL)
+	{
+	  XFree(data);
+	}
+    }
+
+  if (factor == 0.0
+    && output_info->mm_width > 0 && output_info->mm_height > 0
+    && [[NSUserDefaults standardUserDefaults]
+	 boolForKey: @"GSScreenScaleFromSize"])
+    {
+      CGFloat	inches = hypot(output_info->mm_width,
+			       output_info->mm_height) / 25.4;
+      CGFloat	dpi = hypot(crtc_info->width, crtc_info->height) / inches;
+      CGFloat	target = (inches >= 20.0) ? 110.0 : 135.0;
+      CGFloat	step = [[NSUserDefaults standardUserDefaults]
+			 floatForKey: @"GSScaleFactorStep"];
+
+      if (step <= 0.0)
+	{
+	  step = 0.25;
+	}
+      factor = rint(dpi / target / step) * step;
+      if (factor < 1.0)
+	{
+	  factor = 1.0;
+	}
+    }
+
+  return factor;
+}
+#endif
