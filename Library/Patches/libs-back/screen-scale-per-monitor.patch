new file mode 100644
index 000000000..f6e0eac06
--- /dev/null
+++ b/Headers/x11/XGCursorScale.h
@@ -0,0 +1,38 @@
+/*
+ * Copyright (c) 2026 Simon Peter
+ *
+ * SPDX-License-Identifier: BSD-2-Clause OR LGPL-2.1-or-later
+ */
+
+/* The size a cursor is created at on a monitor with a given scale factor.
+ * Plain C without X or AppKit, so it is tested without a display
+ * (Tests/x11/cursorscale.m). */
+
+#ifndef _XGCursorScale_h_INCLUDE
+#define _XGCursorScale_h_INCLUDE
+
+#include <stdint.h>
+
+/* The pixel size of a theme cursor at factor 1.0: the size libXcursor picks
+ * by itself for a 1920x1080 screen and the nominal size of the common
+ * themes, so a 1x monitor keeps the arrow it always had. */
+#define XG_CURSOR_BASE_SIZE 24
+
+/* The pixel size to load a theme cursor at on a monitor of `factor`, or 0
+ * for the size libXcursor chooses itself.  0 is answered when every monitor
+ * runs at exactly 1.0 (`allFactorsOne`), so such setups keep the cursor
+ * they had before monitors could be scaled. */
+int XGCursorThemeSize(double factor, int allFactorsOne);
+
+/* An image cursor's width or height in pixels on a monitor of `factor`,
+ * from its size in points; never below one pixel. */
+int XGCursorScaledLength(double points, double factor);
+
+/* Resample an ARGB image (premultiplied alpha, one uint32_t per pixel, rows
+ * packed) of sw x sh pixels to dw x dh, averaging the source area each
+ * destination pixel covers, so shrinking keeps thin strokes and growing
+ * keeps the edges soft. */
+void XGCursorScaleARGB(const uint32_t *src, int sw, int sh,
+                       uint32_t *dst, int dw, int dh);
+
+#endif
