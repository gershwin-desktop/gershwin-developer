+- (NSRect) workAreaForScreen: (int)screen
+{
+  NSRect workRect = NSZeroRect;
+
+  if (screen < 0 || screen >= monitorsCount)
+    {
+      NSLog(@"Invalidparam: no screen %d", screen);
+      return NSZeroRect;
+    }
+
+  if (monitors != NULL)
+    {
+      workRect = monitors[screen].workArea;
+    }
+
+  return workRect;
+}
