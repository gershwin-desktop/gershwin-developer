diff --git a/Tests/base/NSRegularExpression/initializeDeadlock.m b/Tests/base/NSRegularExpression/initializeDeadlock.m
new file mode 100644
index 000000000..35b02c2ab
--- /dev/null
+++ b/Tests/base/NSRegularExpression/initializeDeadlock.m
@@ -0,0 +1,97 @@
+#import "ObjectTesting.h"
+#import <Foundation/NSAutoreleasePool.h>
+#import <Foundation/NSNotification.h>
+#import <Foundation/NSRegularExpression.h>
+#import <Foundation/NSThread.h>
+#import <Foundation/NSUserDefaults.h>
+#include <stdio.h>
+#include <unistd.h>
+
+/* If NSUserDefaults posts NSUserDefaultsDidChangeNotification while it
+ * still holds its lock, and another thread is meanwhile running the
+ * +initialize of a class that observes that notification and reads a
+ * default from +initialize, the posting thread waits for the class to
+ * finish initializing while +initialize waits for the defaults lock.  Here
+ * the second thread initializes NSRegularExpression while the main thread
+ * is inside a defaults change notification and changes another default.
+ * Each change is followed by -synchronize, which posts the notification
+ * where -setObject:forKey: does not.
+ */
+
+static volatile BOOL finished = NO;
+static BOOL started = NO;
+
+@interface Initializer : NSObject
+@end
+
+@implementation Initializer
++ (void) initializeRegex: (id)unused
+{
+  NSAutoreleasePool *pool = [NSAutoreleasePool new];
+
+  [NSRegularExpression class];
+  [pool release];
+}
+
++ (void) watchdog: (id)unused
+{
+  sleep(10);
+  if (NO == finished)
+    {
+      /* PASS() itself reads the defaults (through NSDateFormatter), so it
+       * would join the deadlock; report with plain stdio and fail the file.
+       */
+      fprintf(stderr, "a defaults change deadlocks with +initialize"
+        " of NSRegularExpression on another thread\n");
+      _exit(1);
+    }
+}
+
++ (void) defaultsChanged: (NSNotification*)n
+{
+  if (NO == started)
+    {
+      started = YES;
+      [NSThread detachNewThreadSelector: @selector(initializeRegex:)
+                               toTarget: self
+                             withObject: nil];
+      usleep(500000);
+      [[NSUserDefaults standardUserDefaults]
+        setObject: @"second" forKey: @"GSInitializeDeadlockTest2"];
+      [[NSUserDefaults standardUserDefaults] synchronize];
+    }
+}
+@end
+
+int main()
+{
+  NSAutoreleasePool     *arp = [NSAutoreleasePool new];
+  NSUserDefaults        *defs = [NSUserDefaults standardUserDefaults];
+
+  [NSThread detachNewThreadSelector: @selector(watchdog:)
+                           toTarget: [Initializer class]
+                         withObject: nil];
+  [[NSNotificationCenter defaultCenter]
+    addObserver: [Initializer class]
+       selector: @selector(defaultsChanged:)
+           name: NSUserDefaultsDidChangeNotification
+         object: nil];
+  [defs setObject: @"first" forKey: @"GSInitializeDeadlockTest1"];
+  [defs synchronize];
+  [[NSNotificationCenter defaultCenter] removeObserver: [Initializer class]];
+  /* The second thread must be able to finish +initialize now. */
+  while (nil == [NSRegularExpression regularExpressionWithPattern: @"a"
+                                                          options: 0
+                                                            error: NULL])
+    {
+      usleep(10000);
+    }
+  finished = YES;
+  PASS(started, "the defaults change notification was delivered")
+  PASS(YES, "a defaults change does not deadlock with +initialize"
+    " of NSRegularExpression on another thread")
+  [defs removeObjectForKey: @"GSInitializeDeadlockTest1"];
+  [defs removeObjectForKey: @"GSInitializeDeadlockTest2"];
+  [arp release];
+  return 0;
+}
