+ */
+#import "Testing.h"
+#import <Foundation/NSAutoreleasePool.h>
+#import <Foundation/NSDate.h>
+#import <Foundation/NSRunLoop.h>
+#import <Foundation/NSString.h>
+#import <Foundation/NSArray.h>
+#import <Foundation/NSTimer.h>
+
+static NSString * const nestedMode = @"GSTestNestedMode";
+
+/* Logs every performer it runs; -outer: runs a nested run loop pass the
+ * way a modal panel opened from a performer does. */
+@interface NestedRunner : NSObject
+{
+@public
+  NSMutableString *log;
+  NSString	  *cancelArgument;
+}
+@end
+
+@implementation NestedRunner
+- (id) init
+{
+  if ((self = [super init]) != nil)
+    {
+      log = [NSMutableString new];
+    }
+  return self;
+}
+
+- (void) dealloc
+{
+  [log release];
+  [super dealloc];
+}
+
+- (void) outer: (id)ignored
+{
+  NSRunLoop	*run = [NSRunLoop currentRunLoop];
+
+  [log appendString: @"A("];
+  if (cancelArgument != nil)
+    {
+      [run cancelPerformSelector: @selector(note:)
+			  target: self
+			argument: cancelArgument];
+    }
+  [run runMode: nestedMode
+    beforeDate: [NSDate dateWithTimeIntervalSinceNow: 0.2]];
+  [log appendString: @")"];
+}
+
+- (void) note: (NSString*)s
+{
+  [log appendString: s];
+}
+
+- (void) tick: (NSTimer*)t
+{
+}
+@end
+
+int main()
+{
+  NSAutoreleasePool	*arp = [NSAutoreleasePool new];
+  NSRunLoop		*run = [NSRunLoop currentRunLoop];
+  NSArray		*defaultOnly;
+  NSArray		*both;
+  NSTimer		*keepAlive;
+  NestedRunner		*r;
+
+  START_SET("NSRunLoop performers and nested run loops")
+
+  /* A run loop without timers or watchers returns at once; a far future
+   * timer in each mode keeps both of them runnable. */
+  keepAlive = [NSTimer timerWithTimeInterval: 1000.0
+				      target: [NestedRunner new]
+				    selector: @selector(tick:)
+				    userInfo: nil
+				     repeats: YES];
+  [run addTimer: keepAlive forMode: NSDefaultRunLoopMode];
+  [run addTimer: keepAlive forMode: nestedMode];
+
+  defaultOnly = [NSArray arrayWithObject: NSDefaultRunLoopMode];
+  both = [NSArray arrayWithObjects: NSDefaultRunLoopMode, nestedMode, nil];
+
+  r = [NestedRunner new];
+  [run performSelector: @selector(outer:) target: r argument: nil
+		 order: 0 modes: defaultOnly];
+  [run performSelector: @selector(note:) target: r argument: @"B"
+		 order: 10 modes: both];
+  [run runMode: NSDefaultRunLoopMode
+    beforeDate: [NSDate dateWithTimeIntervalSinceNow: 0.5]];
+  PASS_EQUAL(r->log, @"A(B)",
+    "a nested run loop fires a performer queued behind the running one"
+    " in a mode the nested loop runs, and it fires only once")
+  [r release];
+
+  r = [NestedRunner new];
+  [run performSelector: @selector(outer:) target: r argument: nil
+		 order: 0 modes: defaultOnly];
+  [run performSelector: @selector(note:) target: r argument: @"C"
+		 order: 10 modes: defaultOnly];
+  [run runMode: NSDefaultRunLoopMode
+    beforeDate: [NSDate dateWithTimeIntervalSinceNow: 0.5]];
+  PASS_EQUAL(r->log, @"A()C",
+    "a performer not scheduled in the nested mode waits for the outer pass")
+  [r release];
+
+  r = [NestedRunner new];
+  r->cancelArgument = @"D";
+  [run performSelector: @selector(outer:) target: r argument: nil
+		 order: 0 modes: defaultOnly];
+  [run performSelector: @selector(note:) target: r argument: @"D"
+		 order: 10 modes: defaultOnly];
+  [run runMode: NSDefaultRunLoopMode
+    beforeDate: [NSDate dateWithTimeIntervalSinceNow: 0.5]];
+  PASS_EQUAL(r->log, @"A()",
+    "a performer cancelled by an earlier performer of the same pass"
+    " does not fire")
+  [r release];
+
+  [keepAlive invalidate];
+
+  END_SET("NSRunLoop performers and nested run loops")
+
+  [arp release];
+  return 0;
+}
