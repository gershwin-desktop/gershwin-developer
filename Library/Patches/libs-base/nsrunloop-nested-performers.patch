+/* Removes p from the performers of context, releasing it; returns NO if
+ * context did not hold p.
+ */
+static BOOL
+removePerformer(GSRunLoopCtxt *context, GSRunLoopPerformer *p)
+{
+  GSIArray	performers = context->performers;
+  unsigned	i = GSIArrayCount(performers);
+
+  while (i-- > 0)
+    {
+      if (GSIArrayItemAtIndex(performers, i).obj == p)
+	{
+	  GSIArrayRemoveItemAtIndex(performers, i);
+	  return YES;
+	}
+    }
+  return NO;
+}
