+/**
+ * This callback function will be called by the Avahi layer on events for the
+ * browsers of the address records of the resolved host.
+ */
+static void
+GSAvahiAddressBrowserEvent(
+  AvahiRecordBrowser *browser,
+  AvahiIfIndex interface,
+  AvahiProtocol protocol,
+  AvahiBrowserEvent event,
+  const char *name,
+  uint16_t dnsClass,
+  uint16_t type,
+  const void *rdata,
+  size_t size,
+  AvahiLookupResultFlags flags,
+  void *userInfo)
+{
+  AvahiAddress addr;
+
+  if ((event != AVAHI_BROWSER_NEW) && (event != AVAHI_BROWSER_REMOVE))
+    {
+      return;
+    }
+  if ((type == AVAHI_DNS_TYPE_A) && (size == 4))
+    {
+      addr.proto = AVAHI_PROTO_INET;
+    }
+  else if ((type == AVAHI_DNS_TYPE_AAAA) && (size == 16))
+    {
+      addr.proto = AVAHI_PROTO_INET6;
+    }
+  else
+    {
+      return;
+    }
+  memcpy(addr.data.data, rdata, size);
+  [(GSAvahiNetService*)userInfo addressBrowserEvent: event
+                                            address: &addr
+                                            ifIndex: interface];
+}
