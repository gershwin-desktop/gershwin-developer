+/* A table or outline view row is often taller than one line of text (a
+   theme may raise the row height, or an application does so to fit icons).
+   Placing the text at the top of such a row looks wrong; centering it
+   vertically is what users expect from a list.  Doing it here rather than
+   in the drawing code keeps the field editor, which is placed with this
+   method as well, exactly on top of the drawn text.  Wrapping cells keep
+   the whole rectangle since they may need several lines. */
+- (NSRect) titleRectForBounds: (NSRect)theRect
+{
+  NSRect titleRect = [super titleRectForBounds: theRect];
+  NSView *controlView = [self controlView];
+
+  if (![self wraps] && [controlView isKindOfClass: [NSTableView class]])
+    {
+      NSAttributedString *text = [self _drawAttributedString];
+      CGFloat textHeight = 0.0;
+
+      if (text != nil)
+	{
+	  textHeight = [text size].height;
+	}
+      /* An empty cell still needs room for the field editor's line. */
+      if (textHeight <= 0.0)
+	{
+	  textHeight = [[self font] defaultLineHeightForFont];
+	}
+      if (textHeight < NSHeight(titleRect))
+	{
+	  titleRect.origin.y += (NSHeight(titleRect) - textHeight) / 2.0;
+	  titleRect.size.height = textHeight;
+	  /* Whole device pixels, or the glyphs are smeared at scale 1. */
+	  titleRect = [controlView centerScanRect: titleRect];
+	}
+    }
+  return titleRect;
+}
