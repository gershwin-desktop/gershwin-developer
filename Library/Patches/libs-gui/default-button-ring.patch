+/* The area in the superview a view may draw into.  A view that returns NO
+ * from -wantsDefaultClipping is not clipped to its frame, so all we know is
+ * that it stays within what the superview shows; subclasses that know
+ * better (NSButton with a default button ring) narrow it down, which keeps
+ * the redraws it causes small. */
+- (NSRect) _drawingExtend
+{
+  if ([self wantsDefaultClipping] || _super_view == nil)
+    {
+      return [self _frameExtend];
+    }
+  return [_super_view visibleRect];
+}
+
+/* -visibleRect for drawing: for a view that does not clip, the part of
+ * its drawing extend the superview shows, in the view's own coordinates.
+ * Display, focus and invalidation use this, so they do not cut what such a
+ * view draws outside its frame. */
+- (NSRect) _visibleDrawingRect
+{
+  NSRect rect;
+
+  if ([self wantsDefaultClipping])
+    {
+      return [self visibleRect];
+    }
+  if ([self isHiddenOrHasHiddenAncestor])
+    {
+      return NSZeroRect;
+    }
+  if (_super_view == nil)
+    {
+      return _bounds;
+    }
+  rect = NSIntersectionRect([self _drawingExtend],
+                            [_super_view visibleRect]);
+  return [self convertRect: rect fromView: _super_view];
+}
