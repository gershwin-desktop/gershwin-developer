--- a/Source/GSToolTips.m
+++ b/Source/GSToolTips.m
@@ -608,6 +608,7 @@ GSDetachToolTipParentWindow(NSWindow *toolTipWindow)
 - (void) _timedOut: (NSTimer *)aTimer
 {
   CGFloat               size;
