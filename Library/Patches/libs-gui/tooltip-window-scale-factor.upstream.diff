   NSString		*toolTipString;
   NSAttributedString	*toolTipText = nil;
   NSSize		textSize;
@@ -683,6 +684,13 @@ GSDetachToolTipParentWindow(NSWindow *toolTipWindow)
   // Need to fudge the result just a bit due to occasionally cutoff characters...
   textSize.width += 1;
   textSize.height += 1;
