+  /* Leave a scroll that does not move anything alone.  The rounding below
+     is relative to this view's position in the window, which itself moves by
+     a fraction of a point whenever the scroll view is laid out again at a
+     fractional scale factor; re-rounding the origin we already have then
+     nudges the content a little further every pass, and a column being
+     resized drifts the rows up the view. */
+  if (fabs(new.x - _bounds.origin.x) < 0.001
+      && fabs(new.y - _bounds.origin.y) < 0.001)
+    {
+      return _bounds.origin;
+    }
