+/** Returns the area, in pixels, of the indicated screen that the window
+    manager leaves to application windows, i.e. without docks and panels. */
+- (NSRect) workAreaForScreen: (int)screen
+{
+  /* An empty rect means the server does not know of one, and the caller
+   * keeps the whole screen; a display server that has no notion of a work
+   * area must not make -[NSScreen visibleFrame] raise. */
+  return NSZeroRect;
+}
