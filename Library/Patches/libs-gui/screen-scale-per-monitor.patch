+  /* A desktop window spans all screens and is never moved to one, so the
+     factor of the screen it overlaps most means nothing for it; switching
+     would resize it away from the screens it has to cover. */
+  if (_wv == nil || (_styleMask & NSUnscaledWindowMask)
+    || _windowLevel <= NSDesktopWindowLevel)
+    {
+      return;
+    }
+  /* A hidden window takes the factor of its screen when it is ordered in;
+     switching it while hidden, with nothing on the screen to judge by,
+     made a window straddling two screens flip at every resize it caused. */
+  if (_f.visible == NO && reason == GSScaleSwitchVisible)
+    {
+      return;
+    }
