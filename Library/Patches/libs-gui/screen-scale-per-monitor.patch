+    {
+      BackingObserver *obs = AUTORELEASE([BackingObserver new]);
+      NSWindow *w5 = AUTORELEASE([[NSWindow alloc]
+        initWithContentRect: NSMakeRect(300, 300, 200, 100)
+                  styleMask: NSBorderlessWindowMask
+                    backing: NSBackingStoreBuffered
+                      defer: NO]);
