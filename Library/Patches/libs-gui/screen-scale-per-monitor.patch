diff --git a/Tests/gui/GSFakeScreens.h b/Tests/gui/GSFakeScreens.h
new file mode 100644
index 000000000..b936c10b9
--- /dev/null
+++ b/Tests/gui/GSFakeScreens.h
@@ -0,0 +1,117 @@
+#ifndef GSFakeScreens_h
+#define GSFakeScreens_h
+
+#import <Foundation/Foundation.h>
+#import <AppKit/AppKit.h>
+#import <GNUstepGUI/GSDisplayServer.h>
+
+@interface GSFakeScreens : NSProxy
+{
+  id _server;
+  NSArray *_frames;
+  NSArray *_resolutions;
+}
++ (GSFakeScreens *) installWithFrames: (NSArray *)frames
+                          resolutions: (NSArray *)resolutions;
+- (void) uninstall;
+@end
+
+@implementation GSFakeScreens
+
++ (GSFakeScreens *) installWithFrames: (NSArray *)frames
+                          resolutions: (NSArray *)resolutions
+{
+  GSFakeScreens *fake = [GSFakeScreens alloc];
+
+  fake->_server = [GSCurrentServer() retain];
+  fake->_frames = [frames retain];
+  fake->_resolutions = [resolutions retain];
+  [GSDisplayServer setCurrentServer: (GSDisplayServer *)fake];
+  [NSScreen resetScreens];
+  return [fake autorelease];
+}
+
+- (void) uninstall
+{
+  [GSDisplayServer setCurrentServer: _server];
+  [NSScreen resetScreens];
+}
+
+- (void) dealloc
+{
+  [_server release];
+  [_frames release];
+  [_resolutions release];
+  [super dealloc];
+}
+
+- (NSArray *) screenList
+{
+  NSMutableArray *list = [NSMutableArray array];
+  NSUInteger i;
+
+  for (i = 0; i < [_frames count]; i++)
+    {
+      [list addObject: [NSNumber numberWithInt: (int)i]];
+    }
+  return list;
+}
+
+- (NSRect) boundsForScreen: (int)screen
+{
+  return [[_frames objectAtIndex: screen] rectValue];
+}
+
+- (NSSize) resolutionForScreen: (int)screen
+{
+  CGFloat dpi = [[_resolutions objectAtIndex: screen] doubleValue];
+
+  return NSMakeSize(dpi, dpi);
+}
+
+- (NSWindowDepth) windowDepthForScreen: (int)screen
+{
+  return [_server windowDepthForScreen: 0];
+}
+
+- (const NSWindowDepth *) availableDepthsForScreen: (int)screen
+{
+  return [_server availableDepthsForScreen: 0];
+}
+
+- (NSMethodSignature *) methodSignatureForSelector: (SEL)aSelector
+{
+  return [_server methodSignatureForSelector: aSelector];
+}
+
+- (void) forwardInvocation: (NSInvocation *)anInvocation
+{
+  [anInvocation invokeWithTarget: _server];
+}
+
+@end
+
+static inline void
+GSSetScaleFactorArgument(NSString *value)
+{
+  NSUserDefaults *defs = [NSUserDefaults standardUserDefaults];
+  NSMutableDictionary *args = [[[defs volatileDomainForName: NSArgumentDomain]
+                                 mutableCopy] autorelease];
+
+  if (args == nil)
+    {
+      args = [NSMutableDictionary dictionary];
+    }
+  if (value == nil)
+    {
+      [args removeObjectForKey: @"GSScaleFactor"];
+    }
+  else
+    {
+      [args setObject: value forKey: @"GSScaleFactor"];
+    }
+  [defs removeVolatileDomainForName: NSArgumentDomain];
+  [defs setVolatileDomain: args forName: NSArgumentDomain];
+}
+
+#endif
diff --git a/Tests/gui/NSScreen/scaleFactor.m b/Tests/gui/NSScreen/scaleFactor.m
new file mode 100644
index 000000000..23c874855
--- /dev/null
+++ b/Tests/gui/NSScreen/scaleFactor.m
@@ -0,0 +1,64 @@
+#import "Testing.h"
+#import <Foundation/Foundation.h>
+#import <AppKit/AppKit.h>
+#import "../GSFakeScreens.h"
+
+int
+main(int argc, const char **argv)
+{
+  CREATE_AUTORELEASE_POOL(arp);
+
+  START_SET("NSScreen scale factor per screen")
+
+  NS_DURING
+    [NSApplication sharedApplication];
+  NS_HANDLER
+    if ([[localException name] isEqualToString: NSInternalInconsistencyException])
+      {
+        SKIP("It looks like GNUstep backend is not yet installed")
+      }
+  NS_ENDHANDLER
+
+  {
+    NSArray *frames = [NSArray arrayWithObjects:
+      [NSValue valueWithRect: NSMakeRect(0, 0, 1000, 800)],
+      [NSValue valueWithRect: NSMakeRect(1000, 0, 1000, 800)], nil];
+    GSFakeScreens *fake;
+    NSArray *screens;
+
+    GSSetScaleFactorArgument(@"1.5");
+
+    fake = [GSFakeScreens installWithFrames: frames
+      resolutions: [NSArray arrayWithObjects: @"144", @"72", nil]];
+    screens = [NSScreen screens];
+    PASS([screens count] == 2, "two screens");
+    PASS([[screens objectAtIndex: 0] userSpaceScaleFactor] == 2.0,
+      "a screen of 144 dpi next to one of 72 dpi has the factor 2");
+    PASS([[screens objectAtIndex: 1] userSpaceScaleFactor] == 1.0,
+      "the screen of 72 dpi next to it has the factor 1");
+    [fake uninstall];
+
+    fake = [GSFakeScreens installWithFrames: frames
+      resolutions: [NSArray arrayWithObjects: @"96", @"96", nil]];
+    screens = [NSScreen screens];
+    PASS([[screens objectAtIndex: 0] userSpaceScaleFactor] == 1.5
+      && [[screens objectAtIndex: 1] userSpaceScaleFactor] == 1.5,
+      "screens of the same resolution use GSScaleFactor");
+    [fake uninstall];
+
+    fake = [GSFakeScreens installWithFrames:
+        [NSArray arrayWithObject: [frames objectAtIndex: 0]]
+      resolutions: [NSArray arrayWithObject: @"144"]];
+    screens = [NSScreen screens];
+    PASS([[screens objectAtIndex: 0] userSpaceScaleFactor] == 1.5,
+      "a single screen uses GSScaleFactor");
+    [fake uninstall];
+
+    GSSetScaleFactorArgument(nil);
+  }
+
+  END_SET("NSScreen scale factor per screen")
+
+  DESTROY(arp);
+  return 0;
+}
